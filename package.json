    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1104.0",
    "@aws-sdk/client-dynamodb": "^3.1104.0",
    "@aws-sdk/client-s3": "^3.1104.0",
    "@aws-sdk/credential-providers": "^3.1104.0",
    "@aws-sdk/lib-dynamodb": "^3.1104.0",
    "@deck.gl/core": "^9.3.7",
    "@deck.gl/extensions": "^9.3.7",
    "@deck.gl/layers": "^9.3.7",
    "@deck.gl/mapbox": "^9.3.7",
    "@opensearch-project/opensearch": "^3.6.0",
    "aws-jwt-verify": "^5.2.1",
    "maplibre-gl": "^5.24.0",
    "next": "16.3.0",
    "oidc-client-ts": "^3.5.0",
    "react": "19.2.8",

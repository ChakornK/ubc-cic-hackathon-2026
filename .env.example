# Required for CDK deploy
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
INGEST_PRINCIPAL_ARN=
CALLBACK_URL=
COGNITO_DOMAIN_PREFIX=

# Optional for CDK deploy
BEDROCK_MODEL_ID=anthropic.claude-haiku-4-5-20251001-v1
SKIP_BUILD=false

# Stack outputs (for local dev, ingest script, smoke tests)
AWS_REGION=us-east-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_DOMAIN=
OPENSEARCH_ENDPOINT=
TABLE_NAME=
DATA_BUCKET=
STACK_URL=

# Client-side auth (NEXT_PUBLIC_ prefix required for browser access)
NEXT_PUBLIC_COGNITO_AUTHORITY=  # e.g. https://cognito-idp.us-east-1.amazonaws.com/us-east-1_AbC123
NEXT_PUBLIC_COGNITO_CLIENT_ID=  # same value as COGNITO_CLIENT_ID
NEXT_PUBLIC_COGNITO_DOMAIN=     # same value as COGNITO_DOMAIN
NEXT_PUBLIC_COGNITO_IDP=Google
NEXT_PUBLIC_API_MOCK=           # set to "1" for offline dev with mock data

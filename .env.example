# AWS region for Bedrock, S3, OpenSearch, DynamoDB clients
AWS_REGION=us-east-1
# Local dev only — Bedrock API key. In AWS deployment the IAM role provides credentials instead.
AWS_BEARER_TOKEN_BEDROCK=
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
# S3 bucket holding the synced datasets (npm run sync-data) and derived artifacts
DATA_BUCKET=
OPENSEARCH_ENDPOINT=
# DynamoDB table for chat sessions
TABLE_NAME=
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
